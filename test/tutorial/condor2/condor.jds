+JobBatchName = "testjob"
+JobFlavour = "espresso"

Universe = vanilla 

Executable = run.sh
Arguments = $(word)
 
Error = $(ClusterId).$(ProcId).err
Output = $(ClusterId).$(ProcId).out
Log = $(ClusterId).log

request_cpus = 1
request_memory = 1000

should_transfer_files = yes

Queue word from list.txt
